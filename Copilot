git checkout <branch>
git pull origin <branch>

# make go.mod + vendor consistent
go mod tidy
GOPROXY=direct go mod vendor      # or your USBank proxy if that's what works

# confirm vendor actually changed and is staged
git status                         # expect vendor/modules.txt + vendor/... changes
git add go.mod go.sum vendor/
git commit -m "<TICKET>: sync vendor directory with go.mod dependency update"
git push
